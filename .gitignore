# 本机路径配置（绝对路径因机而异，模板见 dsh-plugins/youmi-bridge/cordis.patch.yml）
/cordis.local.patch.yml

# DSH 插件构建产物
node_modules/
dsh-plugins/*/lib/
dsh-plugins/*/tsconfig.local.json

# A/B 实验运行产物（沙箱、逐步日志、中间 patch）；
# 已归档的结论与原始数据在 docs/experiments/ 下，不受此规则影响
/.ab/
