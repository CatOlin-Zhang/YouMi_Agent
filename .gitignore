__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 测试 / 工具缓存
.pytest_cache/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/

# IDE
.idea/

# 运行时产物（本地数据库 / 误生成的空文件）
.youmi_tools.db
.youmi/
/PATH

# 本地 DSH 源码（浅克隆参考/运行用，不入库；版本见 docs/dsh-shell-migration-plan.md）
/dsh/

# 本地 DSH 运行时（npm 安装的 @deepseek-ai/dsh，含 typescript 构建工具）
